<Project>

  <PropertyGroup>
    <Product>VsaCheckerAnalytics</Product>
    <Authors>GeoWerkstatt GmbH</Authors>
    <Company>GeoWerkstatt GmbH</Company>
    <Copyright>© GeoWerkstatt GmbH</Copyright>
    <PackageProjectUrl>https://github.com/GeoWerkstatt/vsa-checker-analytics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GeoWerkstatt/vsa-checker-analytics.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Force SQLitePCLRaw above the transitive 2.1.11 that Microsoft.Data.Sqlite still pins.
      2.1.11 bundles a SQLite older than 3.50.2 and is flagged by CVE-2025-6965 (NU1903);
      the 3.0.x line bundles a patched SQLite. Pinned centrally so both projects pick it up.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

</Project>
